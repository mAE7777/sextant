          "default": false,
          "title": "Ordered",
          "type": "boolean"
        },
        "subtasks": {
          "items": {
            "type": "string"
          },
          "title": "Subtasks",
          "type": "array"
        },
        "applicability": {
          "default": "",
          "title": "Applicability",
          "type": "string"
        }
      },
      "title": "Method",
      "type": "object"
    },
    "Node": {
