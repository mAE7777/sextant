        },
        "text_original": {
          "title": "Text Original",
          "type": "string"
        },
        "text_en": {
          "title": "Text En",
          "type": "string"
        },
        "definition": {
          "default": "",
          "title": "Definition",
          "type": "string"
        },
        "answer_space": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnswerSpace"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evaluator": {
          "anyOf": [
            {
              "$ref": "#/$defs/Evaluator"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "state_vector": {
